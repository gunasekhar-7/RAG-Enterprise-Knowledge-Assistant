# ==============================================================================
# RAG Enterprise Knowledge Assistant — Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to '.env' and adjust values for your local environment:
# PowerShell: Copy-Item .env.example .env
# Bash: cp .env.example .env
# ==============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="RAG Enterprise Knowledge Assistant"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Security & JWT ---
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL & pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_knowledge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_knowledge_db

# --- Redis (Sessions, Rate-limiting & Celery Broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=rag-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- OpenAI & AI Providers ---
# Replace with your actual OpenAI API key (starts with sk-...)
OPENAI_API_KEY=sk-proj-mock-api-key-replace-with-your-real-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- RAG Pipeline Tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
CONFIDENCE_THRESHOLD=0.40

# --- Celery Worker ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
